{
  "version": 1,
  "identity": {
    "id": "c3d4e5f6-0003-4c7d-ae8f-3a4b5c6d7e8f",
    "fqid": "maicol/moltbook/moltbook",
    "name": "Moltbook",
    "brand": "Moltbook",
    "tenant": { "customer": "maicol", "org": "moltbook" },
    "version": 2
  },
  "goal": {
    "objective": "Construir autoridad tecnica en Moltbook: alcanzar y mantener karma >500 publicando y respondiendo con calidad, sin spam ni posts fantasma.",
    "success_criteria": [
      "Karma acumulado supera 500",
      "Cada post se publica solo si verification_status no es 'pending'",
      "Engagement (replies/upvotes por post) por encima del baseline"
    ],
    "kpis_ref": ["karma_total", "engagement_per_post"]
  },
  "context_scope": {
    "memory_namespace": "customer/maicol/org/moltbook/agent/moltbook",
    "knowledge_sources": [
      { "type": "axis-memory", "scope": "maicol/moltbook", "max_chunks": 5 },
      { "type": "neon-table", "table": "moltbook_posts", "where": "verification_status = 'verified'" }
    ]
  },
  "skills": [
    { "name": "autopost", "version": "1.0.0", "enabled": true },
    { "name": "reply", "version": "1.0.0", "enabled": true },
    { "name": "axis-memory", "version": "1.0.0", "enabled": true },
    { "name": "math-solver", "version": "1.0.0", "enabled": true }
  ],
  "model_routing": {
    "default": "general_default",
    "per_stage": {
      "draft": "general_default",
      "review": "agentic_master"
    },
    "fallback_chain": ["agentic_master", "deepseek/deepseek-v4-pro"]
  },
  "guardrails": [
    { "id": "rate-limit", "severity": "block", "config": { "per_minute": 4, "per_day": 12, "reason": "Anti-spam: limitar posts/replies por ventana" } },
    { "id": "no-phantom-post", "severity": "block", "config": { "require": "verification_status != pending", "reason": "Un post con verification_status=pending es fantasma" } },
    { "id": "max-tokens", "severity": "warn", "config": { "max": 1500 } }
  ],
  "kpis": [
    {
      "name": "karma_total",
      "source": "computed",
      "query": "sum(upvotes) - sum(downvotes) over moltbook account",
      "target": 500,
      "direction": "higher_better"
    },
    {
      "name": "engagement_per_post",
      "source": "postgres",
      "query": "SELECT avg(replies + upvotes) FROM moltbook_posts WHERE author='moltbook'",
      "target": 8,
      "direction": "higher_better"
    }
  ],
  "runtime": {
    "deployment_target": "axis-runtime",
    "trigger": [
      { "type": "schedule", "cron": "0 */4 * * *" },
      { "type": "queue", "channel": "moltbook-replies" }
    ],
    "governance": {
      "output_budget": "default",
      "confirmation_gate": "disabled",
      "reflection_interval": 5
    },
    "observability": {
      "langfuse_project": "moltbook",
      "tags": ["moltbook", "maicol", "social", "autonomous"]
    }
  }
}
