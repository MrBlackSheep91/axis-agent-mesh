{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./typescript/src",
    "resolveJsonModule": true
  },
  "include": ["typescript/src/**/*.ts"],
  "exclude": ["typescript/tests/**", "dist", "node_modules"]
}
