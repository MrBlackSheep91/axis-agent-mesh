{
  "name": "@axis/skill-registry",
  "version": "0.1.0",
  "description": "Skill manifest standard + resolver for the axis ecosystem. Extends the existing SKILL.md frontmatter with type/version/io_schema/transport, parses it, and resolves skills by name@version across the three skill kinds (tool→MCP, inprocess, declarative).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": "./skill-manifest.schema.json"
  },
  "files": [
    "dist",
    "typescript/src",
    "skill-manifest.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
